# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤 값을 채워주세요.
# 터미널에서: cp .env.example .env

# 서버 포트
PORT=3000

# 로그인 토큰(JWT) 서명에 사용하는 비밀 문자열. 아무 긴 랜덤 문자열이나 넣으면 됩니다.
JWT_SECRET=please-change-this-to-a-long-random-string

# (선택) 번역 API인 MyMemory에 이메일을 등록하면 하루 사용 가능한 번역 글자 수가 늘어납니다.
# 비워두어도 동작합니다 (하루 무료 할당량이 더 적을 뿐입니다).
MYMEMORY_EMAIL=
